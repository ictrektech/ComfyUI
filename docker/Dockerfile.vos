ARG PYTHON_BASE=python:3.12-slim-bookworm
ARG L4T_BASE=swr.cn-southwest-2.myhuaweicloud.com/ictrek/pytorch_py312:jet_2.7.0
ARG TORCH_RUNTIME=wheel

FROM ${L4T_BASE} AS l4t
# The vendor base's httpcore 1.0.8 pins an older h11 than current ComfyUI dependencies.
RUN PIP_CONFIG_FILE=/dev/null PIP_EXTRA_INDEX_URL= python3 -m pip install --no-cache-dir \
    --index-url https://pypi.org/simple httpcore==1.0.9
FROM ${PYTHON_BASE} AS wheel
ARG TORCH_INDEX=cpu
RUN python3 -m pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 torchaudio==2.10.0 \
    --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}"

FROM ${PYTHON_BASE} AS cached-wheel
ARG TORCH_INDEX
ARG TORCH_WHEEL
RUN --mount=type=bind,from=torch_wheels,target=/wheelhouse \
    python3 -m pip install --timeout 120 --no-cache-dir "/wheelhouse/${TORCH_WHEEL}" \
    torchvision==0.25.0 torchaudio==2.10.0 --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}"

FROM ${PYTHON_BASE} AS cached-cuda-wheel
ARG TORCH_INDEX
ARG TORCH_WHEEL
ARG TRITON_WHEEL
RUN --mount=type=bind,from=torch_wheels,target=/wheelhouse \
    python3 -m pip install --timeout 120 --no-cache-dir "/wheelhouse/${TORCH_WHEEL}" "/wheelhouse/${TRITON_WHEEL}" \
    torchvision==0.25.0 torchaudio==2.10.0 --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}"

FROM ${PYTHON_BASE} AS cached-cuda-complete
ARG TORCH_INDEX
ARG TORCH_WHEEL
ARG TRITON_WHEEL
ARG VISION_WHEEL
ARG AUDIO_WHEEL
RUN --mount=type=bind,from=torch_wheels,target=/wheelhouse \
    python3 -m pip install --timeout 120 --no-cache-dir "/wheelhouse/${TORCH_WHEEL}" "/wheelhouse/${TRITON_WHEEL}" \
    "/wheelhouse/${VISION_WHEEL}" "/wheelhouse/${AUDIO_WHEEL}" \
    --index-url "https://download.pytorch.org/whl/${TORCH_INDEX}"

FROM ${TORCH_RUNTIME}
ARG TORCH_RUNTIME
WORKDIR /opt/comfyui
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libgl1 libegl1 libglib2.0-0 libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt docker/check_dependencies.py ./
RUN PIP_CONFIG_FILE=/dev/null PIP_EXTRA_INDEX_URL= python3 -m pip install --timeout 120 --no-cache-dir --index-url https://pypi.org/simple -r requirements.txt && python3 check_dependencies.py
COPY . .
RUN python3 vos/patch_frontend.py
ADD --checksum=sha256:688126d5c2b8c4ff061f56b23c3c6791ac01dc366e98d41ef1aaef374c36f283 https://codeload.github.com/city96/ComfyUI-GGUF/tar.gz/6ea2651e7df66d7585f6ffee804b20e92fb38b8a /tmp/comfyui-gguf.tar.gz
RUN mkdir -p vos/vendor/ComfyUI-GGUF \
    && tar -xzf /tmp/comfyui-gguf.tar.gz -C vos/vendor/ComfyUI-GGUF --strip-components=1 \
    && rm /tmp/comfyui-gguf.tar.gz \
    && PIP_CONFIG_FILE=/dev/null PIP_EXTRA_INDEX_URL= python3 -m pip install --no-cache-dir \
        --index-url https://pypi.org/simple gguf==0.19.0
EXPOSE 8188
ENTRYPOINT ["python3", "vos/gateway.py"]
